	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": {
				"foreground": "#5C6370",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.template",
				"meta.string"
			],
			"settings": {
				"foreground": "#9ECE6A"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character.numeric"
			],
			"settings": {
				"foreground": "#FF9F40"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other",
				"variable.parameter",
				"meta.definition.variable.name"
			],
			"settings": {
				"foreground": "#E4E4E7"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier",
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.logical"
			],
			"settings": {
				"foreground": "#FF7B72"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function",
				"meta.function entity.name.function"
			],
			"settings": {
				"foreground": "#FFC940"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.interface",
				"entity.name.enum",
				"support.class",
				"support.type"
			],
			"settings": {
				"foreground": "#D2A8FF"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"meta.tag entity.name.tag"
			],
			"settings": {
				"foreground": "#FF7B72"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name",
				"meta.attribute"
			],
			"settings": {
				"foreground": "#FFC940"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"keyword.operator"
			],
			"settings": {
				"foreground": "#A8A8AB"
			}
		},
		{
			"scope": [
				"constant.character.escape",
				"constant.other.placeholder"
			],
			"settings": {
				"foreground": "#C2E535"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#B0D605",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#E4E4E7",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#E4E4E7",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.raw.block"
			],
			"settings": {
				"foreground": "#9ECE6A"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"markup.link"
			],
			"settings": {
				"foreground": "#B0D605"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#FF6B6B"
			}
		}
	]
}
